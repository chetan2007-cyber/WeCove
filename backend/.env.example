# ================================================================
# WeCove.in Backend Environment Configuration
# ================================================================

# Server Port
PORT=5000

# Node Environment: development | production
NODE_ENV=development

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000

# PostgreSQL Connection String (Prisma ORM)
DATABASE_URL="postgresql://postgres:password@localhost:5432/wecove_db?schema=public"

# Transactional Email Provider (Resend or equivalent)
EMAIL_PROVIDER_API_KEY=
RESEND_API_KEY=

# Sender Email Address (Verified domain on your email provider)
EMAIL_FROM="WeCove Inquiries <inquiries@wecove.in>"

# Official Destination Email for Project Inquiries
CONTACT_EMAIL=wecove.in@gmail.com

# Direct SMTP / Gmail App Password Fallback (optional)
SMTP_USER=wecove.in@gmail.com
EMAIL_PASS=
