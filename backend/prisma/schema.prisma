datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum InquiryStatus {
  NEW
  IN_REVIEW
  CONTACTED
  ARCHIVED
}

model Inquiry {
  id          String        @id @default(uuid())
  name        String
  email       String
  company     String?
  phone       String?
  projectType String
  budget      String?
  message     String
  status      InquiryStatus @default(NEW)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([email])
  @@index([status])
  @@index([createdAt])
  @@map("inquiries")
}
